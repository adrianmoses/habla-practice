{
  "name": "habla-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npx vite",
    "dev:backend": "node --env-file=.env --watch backend/src/index.js",
    "build": "cd frontend && npm run build",
    "start": "cd backend && node src/index.js",
    "format": "prettier --write 'frontend/src/**/*.{js,jsx}' 'backend/src/**/*.js'",
    "format:check": "prettier --check 'frontend/src/**/*.{js,jsx}' 'backend/src/**/*.js'"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.8.1"
  }
}
