# Anthropic Messages API — used for the live agent (Claude Haiku) and, from P5,
# the LLM-as-judge. Required to start a voice session.
ANTHROPIC_API_KEY=your_key_here

# Groq Whisper — STT. Required to start a voice session.
GROQ_API_KEY=your_key_here

# Cartesia Sonic — streaming TTS. Required to start a voice session.
CARTESIA_API_KEY=your_key_here

# Voice ID for Cartesia. Pick a peninsular Spanish voice from the Cartesia
# dashboard (https://play.cartesia.ai) and paste its ID here. No default —
# session start returns 503 until this is set.
CARTESIA_VOICE_ID=

DATA_DIR=./data
PORT=3000
